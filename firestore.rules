// Private kitchen access, 25 October 2026. See docs/private-kitchen-access.md.
// Template only: publish with KITCHEN_PIN and OWNER_EMAIL filled from existing deployment secrets.
// Current recipe assets are public; operational data requires a personal session or verified admin.
// login/roster contains only the metadata needed to select a name and enter its PIN.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'OWNER_EMAIL' && request.auth.token.email_verified == true;
    }
    // Kitchen data needs a live personal session. Anonymous Firebase auth alone is not a staff login.
    function functionOnly(id) { return id in cfg().get('fnOnlyIds', []); }
    function kitchenRead() { return isAdmin() || (sessOk(reader()) && !functionOnly(reader())); }
    function functionRead() { return isAdmin() || sessOk(reader()); }
    match /kitchens/KITCHEN_PIN/login/roster {
      // Minimal names and permission ids for the PIN screen, never kitchen settings or operational data.
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if isAdmin() || (staff() && sousBy()
        && request.resource.data.keys().hasOnly(['people', 'staffIds', 'sousIds', 'headId', 'fnIds', 'fnOnlyIds', 'by'])
        && request.resource.data.people == getAfter(/databases/$(database)/documents/kitchens/KITCHEN_PIN/config/main).data.people
        && request.resource.data.staffIds == getAfter(/databases/$(database)/documents/kitchens/KITCHEN_PIN/config/main).data.staffIds
        && request.resource.data.sousIds == cfg().get('sousIds', []) && request.resource.data.headId == cfg().get('headId', '')
        && request.resource.data.fnIds == cfg().get('fnIds', []) && request.resource.data.fnOnlyIds == cfg().get('fnOnlyIds', []));
    }
    // Current recipe assets have a fixed public address, so new recipes also work without knowing the kitchen PIN.
    match /publicBook/{id} {
      allow get: if id in ['index', 'matches'];
      allow list: if false;
      allow create, update: if bookBy() && id in ['index', 'matches']
        && request.resource.data == getAfter(/databases/$(database)/documents/kitchens/KITCHEN_PIN/book/$(id)).data;
      allow delete: if false;
    }
    match /publicRecipes/{id} {
      allow read: if true;
      allow create, update: if bookBy()
        && request.resource.data == getAfter(/databases/$(database)/documents/kitchens/KITCHEN_PIN/recipes/$(id)).data;
      allow delete: if false;
    }
    match /publicDrawings/{id} {
      allow read: if true;
      allow create, update: if bookBy()
        && request.resource.data == getAfter(/databases/$(database)/documents/kitchens/KITCHEN_PIN/drawings/$(id)).data;
      allow delete: if false;
    }
    function pinDoc(id) { return /databases/$(database)/documents/kitchens/KITCHEN_PIN/staffpins/$(id); }
    function setDoc(id) { return /databases/$(database)/documents/kitchens/KITCHEN_PIN/pinset/$(id); }
    function sessDoc() { return /databases/$(database)/documents/kitchens/KITCHEN_PIN/sessions/$(request.auth.uid); }
    function triesDoc(id) { return /databases/$(database)/documents/kitchens/KITCHEN_PIN/tries/$(id); }
    // this phone has a session for this person: opened with their PIN, not run out, and their PIN not reset since (pinAt
    // is the pinset time it was opened with; Reset PIN deletes pinset and a new PIN gives a new time)
    function sessOk(id) {
      return request.auth != null && exists(sessDoc())
        && get(sessDoc()).data.by == id
        && get(sessDoc()).data.exp > request.time.toMillis()
        && exists(setDoc(id))
        && get(sessDoc()).data.pinAt == get(setDoc(id)).data.at
        && onList(id);
    }
    // a write: the writer (by) has a session on this phone
    function session() { return request.resource.data.by is string && sessOk(request.resource.data.by); }
    // a read (22 Oct 2026, review S9): who this phone reads as, '' with no session. Use it with sessOk(reader()).
    function reader() { return request.auth != null && exists(sessDoc()) ? get(sessDoc()).data.by : ''; }
    function staff() { return session() && !functionOnly(request.resource.data.by); }
    // Someone taken off the list (Stopped working here) cannot write any more, even with their old PIN. staffIds is the
    // people on the list (config/main); a book that never had one keeps working as before.
    function onList(id) { return !('staffIds' in cfg()) || id in cfg().staffIds; }
    function writer() { return isAdmin() || staff(); }
    function cfg() { return get(/databases/$(database)/documents/kitchens/KITCHEN_PIN/config/main).data; }
    // The head chef or a sous chef, writing as themselves (own PIN session). staff() checks the session: a sous chef's id
    // on its own proves nothing (22 Oct 2026, a ping could be changed with no PIN at all).
    function lead() { return isAdmin() || (staff() && sousBy()); }
    // A picture the book made itself (a data URL), not a link to somewhere else.
    function picture(s) { return s is string && (s.size() == 0 || s.matches('data:image/(png|jpeg|webp);base64,.*')); }
    // The fields a write may set: all of them on a new record, only the changed ones on an old one (so an older
    // record with a field the book no longer writes can still be updated).
    function onlyKeys(list) { return (resource == null ? request.resource.data.keys() : request.resource.data.diff(resource.data).affectedKeys()).hasOnly(list); }
    // A ticked prep line stays ticked. Only the head chef, a sous chef, or the person who ticked it
    // (within 2 minutes, for a mis-tap) may undo it. A tick time cannot be re-stamped by anyone else.
    function sousBy() { return request.resource.data.by in cfg().get('sousIds', []); }
    // People the head chef ticked for Pings (and every sous chef) may write shift pings. The head chef keeps pingIds in step.
    function pingBy() { return request.resource.data.by in cfg().get('pingIds', []); }
    function tickKept() {
      return resource.data.get('done', false) != true
        || (request.resource.data.get('done', false) == true && request.resource.data.get('doneAt', 0) == resource.data.get('doneAt', 0))
        || isAdmin() || sousBy()
        || (request.resource.data.get('done', false) != true && resource.data.get('doneById', '') == request.resource.data.by
            && request.time.toMillis() - resource.data.get('doneAt', 0) < 120000);
    }

    // A sous chef's save keeps the head chef, every sous chef and every function manager on staffIds, so nobody can
    // stop the other chefs' PINs from working (22 Oct 2026). Only the head chef's Google account takes a chef off.
    function keepsChefs() {
      return request.resource.data.get('staffIds', []).hasAll(resource.data.get('sousIds', []))
        && request.resource.data.get('staffIds', []).hasAll(resource.data.get('fnIds', []))
        && (resource.data.get('headId', '') == '' || resource.data.get('headId', '') in request.resource.data.get('staffIds', []));
    }
    match /kitchens/KITCHEN_PIN/config/main {
      allow read: if kitchenRead();
      allow create: if isAdmin();
      // A sous chef (own PIN, no Google sign-in) may only change the people list and staffIds (who may set a PIN),
      // and only if listed in sousIds. sousIds and pingIds can only be changed by the head chef: the admin panel
      // shows the head chef any role or Pings tick a sous chef changed in the people list before it takes effect.
      allow update: if isAdmin() || (staff()
        && request.resource.data.by in resource.data.get('sousIds', [])
        && request.resource.data.people is list && request.resource.data.people.size() <= 80
        && request.resource.data.get('staffIds', []) is list && request.resource.data.get('staffIds', []).size() <= 80
        && keepsChefs()
        && request.resource.data.get('pinOpen', {}) is map && request.resource.data.get('pinOpen', {}).size() <= 80
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['people', 'staffIds', 'pinOpen', 'updated', 'updatedBy', 'by']))
        // the head chef or a sous chef changed a line on a past day: they stamp pastEdit (p prep, o orders) with the time,
        // so the other phones read their saved past days again (22 Oct 2026). Or they saved a shift ping for today (n), so
        // the other phones read the pings again. x is the head chef's Google account removing or putting back a past
        // transfer (23 Oct 2026, written under isAdmin()); it is allowed here too because the stamp is merged into the
        // same map, so a sous chef's next stamp carries it along. Nothing else changes in that write.
        || (staff() && request.resource.data.by in resource.data.get('sousIds', [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pastEdit', 'by'])
          && request.resource.data.pastEdit is map && request.resource.data.pastEdit.keys().hasOnly(['p', 'o', 'n', 'x'])
          && request.resource.data.pastEdit.get('p', 0) is number && request.resource.data.pastEdit.get('o', 0) is number
          && request.resource.data.pastEdit.get('n', 0) is number && request.resource.data.pastEdit.get('x', 0) is number)
        // A returned past loan invalidates the head chef's saved transfer history.
        || (staff() && onlyKeys(['pastEdit', 'by'])
          && request.resource.data.pastEdit is map
          && request.resource.data.pastEdit.diff(resource.data.get('pastEdit', {})).affectedKeys().hasOnly(['x'])
          && request.resource.data.pastEdit.x is number
          && request.resource.data.pastEdit.x >= request.time.toMillis() - 300000
          && request.resource.data.pastEdit.x <= request.time.toMillis() + 60000);
      allow delete: if isAdmin();
    }
    match /kitchens/KITCHEN_PIN/config/admins { allow read, write: if isAdmin(); }
    function lineOk(max) {
      return request.resource.data.text is string && request.resource.data.text.size() <= max
        && request.resource.data.get('qty', '') is string && request.resource.data.get('qty', '').size() <= 40
        && request.resource.data.get('station', '') is string && request.resource.data.get('station', '').size() <= 40;
    }
    // Who writes a line, and when (22 Oct 2026). A new line is written as its writer (addedById is the writer, or ''
    // for a rolled copy). A tick is the ticker's own (doneById). Staff write yesterday's, today's and tomorrow's lists;
    // the head chef, sous chefs and function managers (a function's lines go on its day) write any day. A line holds at
    // most 60 fields. Rights per person (add, tick, remove) are still decided by the page.
    function nearDay(day) {
      return day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.time >= timestamp.date(int(day.split('-')[0]), int(day.split('-')[1]), int(day.split('-')[2])) - duration.value(2055, 'm')
        && request.time < timestamp.date(int(day.split('-')[0]), int(day.split('-')[1]), int(day.split('-')[2])) + duration.value(2295, 'm');
    }
    function lineWho(day) {
      return isAdmin() || ((nearDay(day) || chefId(request.resource.data.by) || request.resource.data.by in cfg().get('fnIds', [])) && request.resource.data.size() <= 60
        && (resource != null || request.resource.data.get('addedById', '') in ['', request.resource.data.by])
        && (request.resource.data.get('done', false) != true || resource.data.get('done', false) == true || request.resource.data.get('doneById', '') == request.resource.data.by));
    }
    function functionLine(key) {
      let id = request.resource.data.get('fn', '');
      let next = getAfter(/databases/$(database)/documents/kitchens/KITCHEN_PIN/functions/$(id)).data;
      let old = get(/databases/$(database)/documents/kitchens/KITCHEN_PIN/functions/$(id));
      return session() && functionOnly(request.resource.data.by) && request.resource.data.by in cfg().get('fnIds', [])
        && id != '' && key.matches('fn-' + id + '.*')
        && (resource == null || resource.data.get('fn', '') == id)
        && next.by == request.resource.data.by && next.v == (!exists(/databases/$(database)/documents/kitchens/KITCHEN_PIN/functions/$(id)) ? 1 : old.data.v + 1)
        && onlyKeys(['text', 'qty', 'station', 'recipe', 'recipes', 'fn', 'dupOk', 'deleted', 'deletedBy', 'deletedAt', 'addedBy', 'addedById', 'addedAt', 'by']);
    }
    match /kitchens/KITCHEN_PIN/days/{day}/items/{item} {
      allow read: if kitchenRead();
      allow create: if (writer() || functionLine(item)) && lineOk(160) && lineWho(day);
      allow update: if (writer() || functionLine(item)) && lineOk(160) && tickKept() && lineWho(day);
      allow delete: if false;
    }
    // An order line is ticked as ordered (or not) only by the head chef or a sous chef, as the page shows (22 Oct 2026).
    match /kitchens/KITCHEN_PIN/orders/{day}/lines/{line} {
      allow read: if kitchenRead();
      allow create: if (writer() || functionLine(line)) && lineOk(120) && lineWho(day) && (request.resource.data.get('ordered', false) == false || lead());
      allow update: if (writer() || functionLine(line)) && lineOk(120) && lineWho(day) && (request.resource.data.get('ordered', false) == resource.data.get('ordered', false) || lead());
      allow delete: if false;
    }
    // Today in kitchen time (Queensland, UTC+10, no daylight saving), with 15 minutes either side for a phone's clock.
    // day is the path's YYYY-MM-DD: its kitchen midnight is 10 hours before UTC midnight of that date.
    function isToday(day) {
      return day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.time >= timestamp.date(int(day.split('-')[0]), int(day.split('-')[1]), int(day.split('-')[2])) - duration.value(615, 'm')
        && request.time < timestamp.date(int(day.split('-')[0]), int(day.split('-')[1]), int(day.split('-')[2])) + duration.value(855, 'm');
    }
    // Wastage log: anyone signed in adds a line; only the head chef's Google account removes or puts one back.
    // Head chef decision (22 Oct 2026): with the kitchen PIN only today's lines can be read. Past days are for the
    // head chef's Google account (the admin panel's wastage log). The phones get what they need from summary/waste.
    match /kitchens/KITCHEN_PIN/waste/{day}/lines/{line} {
      allow read: if isAdmin() || (kitchenRead() && isToday(day));
      allow create: if writer()
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 80
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount < 100000
        && request.resource.data.unit in ['g', 'kg', 'L', 'portions', 'pieces']
        && request.resource.data.reason in ['prep', 'expired', 'fault', 'returned', 'excess']
        && request.resource.data.get('action', '') is string && request.resource.data.get('action', '').size() <= 120
        && request.resource.data.get('station', '') is string && request.resource.data.get('station', '').size() <= 40;
      // Head chef decision (22 Oct 2026): only the head chef's Google account removes or puts back an entry. A sous chef
      // may Undo their own entry straight after logging it (2 minutes on the server's time), and only the removed fields.
      allow update: if (isAdmin() && request.resource.data.text is string && request.resource.data.text.size() <= 80)
        || (staff() && sousBy() && resource.data.get('addedById', '') == request.resource.data.by
          && request.time.toMillis() - resource.data.get('addedAt', 0) < 120000
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedBy', 'deletedAt', 'by']));
      allow delete: if false;
    }
    // End-of-day waste review, one per day. Everyone reads it (the change for the next shift shows on the prep list);
    // only the head chef or a sous chef writes it: today's on the wastage page, past days in the admin panel's wastage log.
    match /kitchens/KITCHEN_PIN/waste/{day} {
      allow read: if kitchenRead();
      allow create, update: if writer() && lead()
        && request.resource.data.get('avoidable', '') is string && request.resource.data.get('avoidable', '').size() <= 300
        && request.resource.data.get('change', '') is string && request.resource.data.get('change', '').size() <= 300;
      allow delete: if false;
    }
    // Stock transfers between venues (#/transfers, 23 Oct 2026): one record per transfer, transfers/<day>/lines/<id>.
    // dir is out (another venue took it from us) or in (we took it from them), then the venue, who came for it or gave
    // it, the item, the amount and unit, and a note. Names and amounts only, never a price.
    // Like the wastage log: anyone signed in logs a line, as themselves (addedById is the writer), on yesterday's, today's
    // or tomorrow's list, so a line saved with no signal near midnight still lands. addedAt is at most 15 minutes ahead
    // of the server's time, so nobody can stretch the 2 minute Undo.
    // With the kitchen PIN only today's lines can be read. Past days are for the head chef's Google account (the admin
    // panel's Transfers report); the phones get venue and item names from summary/transfers.
    // Only that account removes or puts one back. A sous chef may Undo their own line straight after logging it
    // (2 minutes on the server's time). Either way only the removed fields change. Never deleted.
    // The head chef may also create one when moving everything to a new kitchen PIN (an exact copy of the old record).
    function xferOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['dir', 'venue', 'person', 'text', 'amount', 'unit', 'note', 'addedBy', 'addedById', 'addedAt', 'deleted', 'tst', 'by'])
        && d.dir in ['out', 'in']
        && d.venue is string && d.venue.size() > 0 && d.venue.size() <= 40
        && d.get('person', '') is string && d.get('person', '').size() <= 40
        && d.text is string && d.text.size() > 0 && d.text.size() <= 80
        && d.amount is number && d.amount > 0 && d.amount < 100000
        && d.unit in ['g', 'kg', 'L', 'pieces', 'packs', 'boxes']
        && d.get('note', '') is string && d.get('note', '').size() <= 120
        && d.get('addedBy', '') is string && d.get('addedBy', '').size() <= 80
        && d.addedById == d.by
        && d.addedAt is number && d.addedAt <= request.time.toMillis() + 900000
        && d.deleted == false
        && d.get('tst', false) is bool;
    }
    // Remove, Put back and Undo: only the removed fields (and the writer), each of the right type.
    function xferDel() {
      let d = request.resource.data;
      return onlyKeys(['deleted', 'deletedBy', 'deletedAt', 'by'])
        && d.deleted is bool
        && d.get('deletedBy', '') is string && d.get('deletedBy', '').size() <= 80
        && d.get('deletedAt', 0) is number;
    }
    // A return closes a loan in full. Only return fields change, never its amount or venue.
    // The writer may undo a mis-tap for two minutes; a chef may reopen it later.
    function xferReturn(day, line) {
      let d = request.resource.data;
      return getAfter(/databases/$(database)/documents/kitchens/KITCHEN_PIN/transferOpen/$(day + '_' + line)).data.record == d
        && onlyKeys(['returned', 'returnedBy', 'returnedById', 'returnedAt', 'by'])
        && resource.data.get('deleted', false) == false
        && d.returned is bool
        && d.returnedBy is string && d.returnedBy.size() <= 80
        && d.returnedById is string
        && d.returnedAt is number
        && (d.returned == true
          ? resource.data.get('returned', false) == false
            && (isAdmin() || d.returnedById == d.get('by', ''))
            && d.returnedAt <= request.time.toMillis() + 60000
            && d.returnedAt >= request.time.toMillis() - 300000
          : resource.data.get('returned', false) == true
            && d.returnedBy == '' && d.returnedById == '' && d.returnedAt == 0
            && (isAdmin() || sousBy() || (resource.data.get('returnedById', '') == d.by
              && request.time.toMillis() - resource.data.get('returnedAt', 0) < 120000)));
    }
    // The open index is an exact copy of its dated line in the same atomic write.
    // Staff can query open loans across all dates without reading the private history.
    match /kitchens/KITCHEN_PIN/transferOpen/{key} {
      allow read: if isAdmin() || (kitchenRead() && resource.data.open == true);
      allow create, update: if writer()
        && request.resource.data.keys().hasOnly(['date', 'lineId', 'record', 'open', 'by'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.lineId is string
        && key == request.resource.data.date + '_' + request.resource.data.lineId
        && request.resource.data.record == getAfter(/databases/$(database)/documents/kitchens/KITCHEN_PIN/transfers/$(request.resource.data.date)/lines/$(request.resource.data.lineId)).data
        && request.resource.data.open == (request.resource.data.record.get('deleted', false) == false && request.resource.data.record.get('returned', false) == false);
      allow delete: if false;
    }
    match /kitchens/KITCHEN_PIN/transfers/{day}/lines/{line} {
      allow read: if isAdmin() || (kitchenRead() && isToday(day));
      allow create: if isAdmin() || (staff() && nearDay(day) && xferOk());
      allow update: if (writer() && xferReturn(day, line)) || (isAdmin() && xferDel())
        || (staff() && sousBy() && resource.data.get('addedById', '') == request.resource.data.by
          && request.time.toMillis() - resource.data.get('addedAt', 0) < 120000 && xferDel());
      allow delete: if false;
    }
    // What was wasted in the last 14 days, written each night by the server (scripts/nightly-learn.mjs, service account).
    // The phones only read it; the head chef's Google account may copy it when the kitchen PIN moves.
    // Usage and speed counts (22 Oct 2026): one record a day per phone, counts only (no names, no text). Written by
    // anyone signed in, as themselves; read and deleted only by the head chef's Google account and the nightly job.
    match /kitchens/KITCHEN_PIN/daily/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if writer()
        && id == request.resource.data.day + '_' + request.resource.data.tag
        && request.resource.data.day is string && request.resource.data.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.tag is string && request.resource.data.tag.matches('[a-z0-9]{1,12}')
        && request.resource.data.sg is map && request.resource.data.sg.size() <= 12
        && request.resource.data.pf is map && request.resource.data.pf.size() <= 4
        && request.resource.data.at is number
        && request.resource.data.keys().hasOnly(['day', 'tag', 'sg', 'pf', 'at', 'by']);
    }
    match /kitchens/KITCHEN_PIN/summary/{id} {
      allow read: if kitchenRead();
      allow write: if isAdmin();
    }
    // Recipe book searches that found nothing.
    match /kitchens/KITCHEN_PIN/misses/{id} {
      allow read: if kitchenRead();
      allow create, update: if isAdmin() || (staff() && request.resource.data.q is string && request.resource.data.q.size() <= 60
        && onlyKeys(['q', 'n', 'last', 'lastBy', 'hidden', 'by']));
      allow delete: if isAdmin();
    }
    // Recipe cards opened (counts only).
    match /kitchens/KITCHEN_PIN/views/{id} {
      allow read: if kitchenRead();
      allow create, update: if isAdmin() || (staff() && request.resource.data.name is string && request.resource.data.name.size() <= 80 && request.resource.data.n is int
        && onlyKeys(['name', 'n', 'last', 'by']));
      allow delete: if isAdmin();
    }
    // Shift pings (stored as notes), shown as a popup. Everyone with the kitchen PIN reads them; only the head chef,
    // a sous chef, or someone listed in pingIds (ticked for Pings in the People tab) writes them.
    // A note shows from "start" to "until" (YYYY-MM-DD). "dows" (0 to 6, Sunday is 0) limits it to those weekdays.
    // Notes are never deleted, only flagged as removed.
    function noteOk() {
      return request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 400
        && request.resource.data.tag in ['none', 'off', 'special', 'function', 'delivery', 'safety', 'allergen']
        && request.resource.data.start is string && request.resource.data.start.size() == 10
        && request.resource.data.until is string && request.resource.data.until.size() == 10
        && request.resource.data.until >= request.resource.data.start
        && request.resource.data.get('dows', []) is list && request.resource.data.get('dows', []).size() <= 7
        // its own time of day (22 Oct 2026): minutes after midnight, or null for the usual 10:30 popup
        && (request.resource.data.get('tm', null) == null || (request.resource.data.tm is int && request.resource.data.tm >= 0 && request.resource.data.tm <= 1439))
        && request.resource.data.get('removed', false) is bool;
    }
    // A ping is changed or removed by the person who wrote it (author, kept from the first save; older pings have only by),
    // the head chef, or a sous chef. A sous chef's edit does not take the ping over: the writer can still change it.
    match /kitchens/KITCHEN_PIN/notes/{id} {
      allow read: if kitchenRead();
      allow create: if (isAdmin() || (staff() && (sousBy() || pingBy()))) && noteOk();
      allow update: if (lead() || (staff() && pingBy() && resource.data.get('author', resource.data.get('by', '')) == request.resource.data.by)) && noteOk();
      allow delete: if false;
    }
    // Kitchen meeting minutes. Only the head chef (Google account) writes them (draft, then published). Sous chefs read the register. Everyone with the kitchen PIN reads the published ones.
    // Minutes are never deleted, only flagged as removed. "v" is the version: a change after publishing makes version 2 and everyone signs again.
    // Every earlier version is kept in minutes/<id>/hist/<v> and cannot be changed.
    // A person signs once per version, as themselves (their own PIN session): minutes/<id>/signs/<v>_<staffId>. A sign-off cannot be changed or deleted.
    // Drafts are for the head chef's Google account only (22 Oct 2026, review S9). A draft never carries pubAt (the time it
    // was published), so the kitchen's list of minutes asks for pubAt from a date on, which the rules can check; reading
    // one record needs it published.
    function minutesOk() {
      return request.resource.data.status in ['draft', 'published']
        && (request.resource.data.status == 'published' || !('pubAt' in request.resource.data))
        && request.resource.data.v is int && request.resource.data.v >= 1 && request.resource.data.v <= 50
        && request.resource.data.no is int && request.resource.data.no >= 1
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.get('start', '') is string && request.resource.data.get('start', '').size() <= 5
        && request.resource.data.get('loc', '') is string && request.resource.data.get('loc', '').size() <= 60
        && request.resource.data.get('guests', '') is string && request.resource.data.get('guests', '').size() <= 120
        && request.resource.data.get('chair', '') is string && request.resource.data.get('chair', '').size() <= 80
        && request.resource.data.get('taker', '') is string && request.resource.data.get('taker', '').size() <= 80
        && request.resource.data.get('next', '') is string && request.resource.data.get('next', '').size() <= 10
        && request.resource.data.get('decisions', '') is string && request.resource.data.get('decisions', '').size() <= 1200
        && request.resource.data.get('menu', '') is string && request.resource.data.get('menu', '').size() <= 1200
        && request.resource.data.get('safety', '') is string && request.resource.data.get('safety', '').size() <= 1200
        && request.resource.data.get('dates', '') is string && request.resource.data.get('dates', '').size() <= 1200
        && request.resource.data.get('other', '') is string && request.resource.data.get('other', '').size() <= 1200
        && request.resource.data.get('att', []) is list && request.resource.data.get('att', []).size() <= 80
        && request.resource.data.get('acts', []) is list && request.resource.data.get('acts', []).size() <= 40
        && request.resource.data.get('removed', false) is bool;
    }
    match /kitchens/KITCHEN_PIN/minutes/{id} {
      allow get: if isAdmin() || (kitchenRead() && resource.data.status == 'published');
      allow list: if isAdmin() || (kitchenRead() && resource.data.pubAt >= 1);
      allow create, update: if isAdmin() && minutesOk();
      allow delete: if false;
      match /hist/{v} {
        allow read: if isAdmin();
        allow create: if isAdmin() && minutesOk();
        allow update, delete: if false;
      }
      // The head chef may also create one when moving everything to a new kitchen PIN (an exact copy of the old record).
      match /signs/{sid} {
        allow read: if isAdmin();
        allow create: if (isAdmin() && request.resource.data.v is int && request.resource.data.st in ['present', 'apology', 'absent']) || (staff()
          && request.resource.data.v is int
          && request.resource.data.st in ['present', 'apology', 'absent']
          && request.resource.data.at is number
          && sid == string(request.resource.data.v) + '_' + request.resource.data.by
          && get(/databases/$(database)/documents/kitchens/KITCHEN_PIN/minutes/$(id)).data.status == 'published'
          && get(/databases/$(database)/documents/kitchens/KITCHEN_PIN/minutes/$(id)).data.v == request.resource.data.v);
        allow update, delete: if false;
      }
    }
    // How-to guides (#/guides). Everyone with the kitchen PIN reads them; only the head chef (Google account) writes them.
    // Each PDF page or photo is one picture in guides/<id>/pages/<n> (a Firestore record holds at most 1 MB).
    // "v" goes up when the file is replaced. Guides are never deleted, only flagged as removed. Page pictures may be
    // replaced or deleted by the head chef (a new file with fewer pages deletes the pages it no longer needs).
    function guideOk() {
      return request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.cat in ['equipment', 'cleaning', 'safety', 'prep', 'stock', 'shift', 'other']
        && request.resource.data.get('sum', '') is string && request.resource.data.get('sum', '').size() <= 200
        && request.resource.data.get('steps', '') is string && request.resource.data.get('steps', '').size() <= 3000
        && request.resource.data.get('kw', '') is string && request.resource.data.get('kw', '').size() <= 200
        && request.resource.data.get('text', '') is string && request.resource.data.get('text', '').size() <= 8000
        && picture(request.resource.data.get('thumb', '')) && request.resource.data.get('thumb', '').size() <= 60000
        && request.resource.data.get('file', '') is string && request.resource.data.get('file', '').size() <= 120
        && request.resource.data.pages is int && request.resource.data.pages >= 0 && request.resource.data.pages <= 20
        && request.resource.data.get('dims', []) is list && request.resource.data.get('dims', []).size() <= 20
        && request.resource.data.v is int && request.resource.data.v >= 1
        && request.resource.data.get('removed', false) is bool;
    }
    match /kitchens/KITCHEN_PIN/guides/{id} {
      allow read: if kitchenRead();
      allow create, update: if isAdmin() && guideOk();
      allow delete: if false;
      match /pages/{n} {
        allow read: if kitchenRead();
        allow create, update: if isAdmin() && picture(request.resource.data.img) && request.resource.data.img.size() > 0 && request.resource.data.img.size() <= 1000000
          && request.resource.data.v is int && request.resource.data.n is int;
        allow delete: if isAdmin();
      }
    }
    // The head chef's book (#/manage, 21 Oct 2026): recipes changed or added in the book itself, laid over js/data.js.
    // Everyone with the kitchen PIN reads them. Only the head chef writes them: with their Google account while nobody
    // else is signed in with a PIN on that device, or with their own PIN as the person in config/main headId (which only
    // the Google account can set). Sous chefs and staff only read.
    // book/index lists each changed recipe and its version (r) and the guest menu order (menu), so a phone reads one
    // record to know what is new. A recipe's version goes up by one with every save and the index must say the same
    // version in the same batch, so a save made from an old copy is refused. Recipes are never deleted (removed hides
    // one, off goes back to the js/data.js copy); every earlier version is kept in recipes/<id>/hist/<v>, which nobody can change.
    function headWrite() { return cfg().get('headId', '') != '' && staff() && request.resource.data.by == cfg().get('headId', ''); }
    function recipeWrite() { return staff() && chefId(request.resource.data.by); }
    function bookBy() { return (isAdmin() && request.resource.data.get('by', '') in ['', cfg().get('headId', '')]) || recipeWrite(); }
    function bookIndex() { return getAfter(/databases/$(database)/documents/kitchens/KITCHEN_PIN/book/index).data; }
    function nextVersion() { return request.resource.data.v is int && request.resource.data.v == (resource == null ? 1 : resource.data.v + 1); }
    function recipeOk(id) {
      let d = request.resource.data;
      let r = d.r;
      return id.matches('[a-z0-9][a-z0-9-]{0,47}')
        && d.keys().hasOnly(['r', 'v', 'upd', 'by', 'src', 'base', 'removed', 'off'])
        && d.v is int && d.v >= 1 && d.upd is int
        && d.get('src', 'book') in ['book', 'new'] && d.get('base', '') is string && d.get('base', '').size() <= 16
        && d.get('removed', false) is bool && d.get('off', false) is bool
        && r is map && r.id == id
        && r.keys().hasOnly(['id', 'no', 'kind', 'forLine', 'name', 'short', 'avc', 'menu', 'yield', 'art', 'side', 'diagram', 'ingredients', 'pins', 'sections', 'contains', 'check', 'labelNote', 'tip', 'safety', 'done', 'aka'])
        && r.name is string && r.name.size() > 0 && r.name.size() <= 80
        && r.kind in ['main', 'snack', 'side', 'dessert', 'batch', 'component']
        && r.get('no', '') is string && r.get('no', '').size() <= 8
        && r.get('yield', '') is string && r.get('yield', '').size() <= 300
        && r.get('menu', '') is string && r.get('menu', '').size() <= 400
        && r.get('ingredients', []) is list && r.get('ingredients', []).size() <= 100
        && r.get('pins', []) is list && r.get('pins', []).size() <= 60
        && r.get('sections', []) is list && r.get('sections', []).size() <= 30;
    }
    match /kitchens/KITCHEN_PIN/book/index {
      allow read: if true;
      allow create, update: if (isAdmin() || recipeWrite())
        && request.resource.data.keys().hasOnly(['r', 'd', 'menu', 'by', 'upd'])
        && request.resource.data.get('r', {}) is map && request.resource.data.get('r', {}).size() <= 1000
        && request.resource.data.get('d', {}) is map && request.resource.data.get('d', {}).size() <= 3000
        && request.resource.data.get('menu', []) is list && request.resource.data.get('menu', []).size() <= 40;
      allow delete: if false;
    }
    // Draw it for me (21 Oct 2026): the library drawing the head chef picked for an ingredient name (m, name to drawing id),
    // so the next recipe gets it right first time. Saved with merge, in the same batch as the drawing. Never deleted.
    match /kitchens/KITCHEN_PIN/book/matches {
      allow read: if true;
      allow create, update: if bookBy()
        && request.resource.data.keys().hasOnly(['m', 'upd', 'by'])
        && request.resource.data.m is map && request.resource.data.m.size() <= 3000
        && request.resource.data.get('upd', 0) is int;
      allow delete: if false;
    }
    match /kitchens/KITCHEN_PIN/recipes/{id} {
      allow read: if true;
      // the head chef's Google account may also copy a recipe as it is (move to a new kitchen PIN)
      allow create: if recipeOk(id) && bookBy() && (isAdmin() || (nextVersion() && bookIndex().get('r', {}).get(id, 0) == request.resource.data.v));
      allow update: if recipeOk(id) && bookBy() && nextVersion() && bookIndex().get('r', {}).get(id, 0) == request.resource.data.v;
      allow delete: if false;
      match /hist/{v} {
        allow read: if kitchenRead();
        allow create: if bookBy() && request.resource.data.keys().hasOnly(['was', 'at', 'by']) && request.resource.data.was is map && request.resource.data.at is int
          && (isAdmin() || getAfter(/databases/$(database)/documents/kitchens/KITCHEN_PIN/recipes/$(id)).data.v == int(v) + 1);
        allow update, delete: if false;
      }
    }
    // The head chef's drawings (Manage Recipes & Drawings, 21 Oct 2026): what the editor needs to open a drawing again
    // (servingware, elements, a copy of each library piece used) and the flat SVG the book shows. Same lock and versions
    // as the recipes: book/index d says each drawing's version in the same batch. Never deleted; earlier versions kept.
    function drawingOk(id) {
      let d = request.resource.data;
      return id.matches('[a-z0-9][a-z0-9-]{0,63}')
        && d.keys().hasOnly(['rid', 'slot', 'name', 'vb', 'k', 'surf', 'els', 'layout', 'defs', 'svgS', 'svgF', 'alt', 'title', 'from', 'v', 'upd', 'by', 'removed'])
        && d.v is int && d.v >= 1 && d.upd is int
        && d.slot in ['plate', 'pan', 'side', 'build']
        && d.get('rid', '') is string && d.get('rid', '').size() <= 48
        && d.get('name', '') is string && d.get('name', '').size() <= 80
        && d.vb is string && d.vb.size() <= 60
        && d.get('k', 1) is number
        && d.get('surf', {}) is map
        && d.get('els', []) is list && d.get('els', []).size() <= 600
        && d.get('layout', {}) is map
        && d.get('defs', '') is string && d.get('defs', '').size() <= 300000
        && d.svgS is string && d.svgS.size() <= 200000
        && d.svgF is string && d.svgF.size() <= 300000
        && d.get('alt', '') is string && d.get('alt', '').size() <= 600
        && d.get('title', '') is string && d.get('title', '').size() <= 60
        && d.get('from', '') is string && d.get('from', '').size() <= 80
        && d.get('removed', false) is bool;
    }
    match /kitchens/KITCHEN_PIN/drawings/{id} {
      allow read: if true;
      // the head chef's Google account may also copy a drawing as it is (move to a new kitchen PIN)
      allow create: if drawingOk(id) && bookBy() && (isAdmin() || (nextVersion() && bookIndex().get('d', {}).get(id, 0) == request.resource.data.v));
      allow update: if drawingOk(id) && bookBy() && nextVersion() && bookIndex().get('d', {}).get(id, 0) == request.resource.data.v;
      allow delete: if false;
      match /hist/{v} {
        allow read: if kitchenRead();
        allow create: if bookBy() && request.resource.data.keys().hasOnly(['was', 'at', 'by']) && request.resource.data.was is map && request.resource.data.at is int
          && (isAdmin() || getAfter(/databases/$(database)/documents/kitchens/KITCHEN_PIN/drawings/$(id)).data.v == int(v) + 1);
        allow update, delete: if false;
      }
    }
    // Reuse (21 Oct 2026): the head chef's plating templates (drawtpl) and own library pieces and servingware (drawlib).
    // Read by the drawing editor only. Only the head chef writes them; each change is the next version; never deleted
    // (removed hides one). The head chef's Google account may also copy one as it is (move to a new kitchen PIN).
    function tplOk(id) {
      let d = request.resource.data;
      return id.matches('[a-z0-9][a-z0-9-]{0,63}')
        && d.keys().hasOnly(['name', 'slot', 'surf', 'els', 'defs', 'vb', 'svgS', 'svgF', 'v', 'upd', 'by', 'removed'])
        && d.v is int && d.v >= 1 && d.upd is int
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.slot in ['plate', 'pan', 'side', 'build']
        && d.get('surf', {}) is map
        && d.els is list && d.els.size() <= 600
        && d.get('defs', '') is string && d.get('defs', '').size() <= 300000
        && d.get('vb', '') is string && d.get('vb', '').size() <= 60
        && d.get('svgS', '') is string && d.get('svgS', '').size() <= 200000
        && d.get('svgF', '') is string && d.get('svgF', '').size() <= 300000
        && d.get('removed', false) is bool;
    }
    function libOk(id) {
      let d = request.resource.data;
      return id.matches('[a-z0-9][a-z0-9-]{0,63}')
        && d.keys().hasOnly(['type', 'name', 'cat', 'kw', 'role', 'form', 'g', 'n', 'w', 'h', 'body', 'side', 'p', 'v', 'upd', 'by', 'removed'])
        && d.v is int && d.v >= 1 && d.upd is int
        && d.type in ['item', 'surf']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.get('kw', '') is string && d.get('kw', '').size() <= 300
        && d.get('body', '') is string && d.get('body', '').size() <= 100000
        && d.get('side', {}) is map && d.get('p', {}) is map
        && (d.type == 'surf' || (d.body.size() > 0 && d.w is number && d.h is number && d.w > 0 && d.h > 0))
        && d.get('removed', false) is bool;
    }
    match /kitchens/KITCHEN_PIN/drawtpl/{id} {
      allow read: if true;
      allow create: if tplOk(id) && bookBy() && (isAdmin() || nextVersion());
      allow update: if tplOk(id) && bookBy() && nextVersion();
      allow delete: if false;
    }
    match /kitchens/KITCHEN_PIN/drawlib/{id} {
      allow read: if true;
      allow create: if libOk(id) && bookBy() && (isAdmin() || nextVersion());
      allow update: if libOk(id) && bookBy() && nextVersion();
      allow delete: if false;
    }
    // Functions (21 Oct 2026): function bookings with platters, for the kitchen. Everyone with the kitchen PIN reads the
    // kitchen copy (functions/<id>: no phone or email). Only a function manager writes: the head chef's Google account, or
    // a person ticked for Manage functions in the admin People tab (config/main fnIds, which only the Google account can
    // change), writing as themselves with their own PIN. Taking the tick away refuses their very next save.
    // A function's version goes up by one with every save, so a save made from an old copy is refused. Never deleted:
    // a cancelled function stays, and every earlier version is kept in functions/<id>/hist/<v>, which nobody can change.
    // A confirmed function must add up: every platter line's rounds sum to its booked number, rounds in time order.
    // Rules cannot loop, so the checks are written out for up to 8 platter lines and 8 rounds.
    function fnBy() { return isAdmin() || (session() && request.resource.data.by in cfg().get('fnIds', [])); }
    // Chefs can cancel a saved booking without permission to edit its food, time or contact. Undo is their own
    // most recent cancellation, for two minutes, restoring status and ordering from the immutable history.
    function fnStatusBy() { return isAdmin() || (session() && (chefId(request.resource.data.by) || request.resource.data.by in cfg().get('fnIds', []))); }
    function fnCancelChange(was, d) {
      return was.status == 'confirmed' && d.status == 'cancelled'
        && d.diff(was).affectedKeys().hasOnly(['status', 'v', 'upd', 'by', 'canBy', 'canAt', 'od', 'chg'])
        && d.canBy == d.by && d.canAt == d.upd && d.od == ''
        && d.canAt >= request.time.toMillis() - 60000 && d.canAt <= request.time.toMillis() + 15000;
    }
    function fnUndoChange(id, was, d) {
      let old = get(/databases/$(database)/documents/kitchens/KITCHEN_PIN/functions/$(id)/hist/$(string(was.v - 1))).data.was;
      return was.status == 'cancelled' && d.status == 'confirmed'
        && was.canBy == d.by && was.upd == was.canAt && request.time.toMillis() - was.canAt < 120000
        && d.diff(was).affectedKeys().hasOnly(['status', 'v', 'upd', 'by', 'od', 'kq', 'chg'])
        && old.status == 'confirmed' && d.kq == old.kq && d.od == old.get('od', '') && fnConfirmed(d);
    }
    function fnStatusChange(id, was, d) {
      return d.upd is int && d.chg is list && d.chg.size() <= 8
        && (was.status == 'confirmed' && d.status == 'cancelled' ? fnCancelChange(was, d)
          : was.status == 'cancelled' && d.status == 'confirmed' ? fnUndoChange(id, was, d) : false);
    }
    function fnStatusAudit(id, was, d) {
      let hist = getAfter(/databases/$(database)/documents/kitchens/KITCHEN_PIN/functions/$(id)/hist/$(string(was.v))).data;
      return hist.was == was && hist.by == d.by && hist.at == d.upd;
    }
    function fnStatusHistory(id, v) {
      let was = get(/databases/$(database)/documents/kitchens/KITCHEN_PIN/functions/$(id)).data;
      let next = getAfter(/databases/$(database)/documents/kitchens/KITCHEN_PIN/functions/$(id)).data;
      // The next function must pass its own update rule in this same batch. Do not re-run all booking checks here:
      // Firestore caps a save at 1000 expressions, including its history copy.
      return was.v == int(v) && next.v == was.v + 1 && next.status != was.status
        && request.resource.data.was == was && request.resource.data.at == next.upd && request.resource.data.by == next.by;
    }
    // A platter line: what was booked (qty, whole platters) and which round each platter goes out in (u, one round number
    // per platter, 0 for the first round). So 5 platters over 3 rounds as 2, 2 and 1 is u [0, 0, 1, 1, 2]. A confirmed line
    // has exactly as many entries as platters booked, and every entry is a round that exists: the rounds add up to the
    // booking, with no half or minus platters, by construction. Rules cannot loop, so the 6 lines are written out.
    // Up to 12 platter lines (22 Oct 2026). A line that is there has exactly as many entries as platters booked, and
    // every entry is a round that exists. The page keeps the rounds in time order; the rules check the first and last.
    function fnAdd(l, n) { return l.u.size() == l.qty && l.qty >= 1; }
    // a confirmed function: a name, date, start and guests (or guests ticked Not known yet, gu; the start may be TBC, st), at least one platter line, one round for all at once or two
    // or more for staggered, first and last the same as the rounds say (the page keeps the rounds in time order)
    function fnConfirmed(d) {
      return d.name.size() > 0 && d.date.size() == 10 && (d.start > 0 || d.get('st', false) == true) && (d.guests >= 1 || d.get('gu', false) == true)
        && d.lines.size() >= 1 && d.rounds.size() >= 1 && (d.mode == 'all' ? d.rounds.size() == 1 : d.rounds.size() >= 2)
        && fnAdd(d.lines[0], d.rounds.size()) && (d.lines.size() < 2 || fnAdd(d.lines[1], d.rounds.size())) && (d.lines.size() < 3 || fnAdd(d.lines[2], d.rounds.size())) && (d.lines.size() < 4 || fnAdd(d.lines[3], d.rounds.size()))
        && (d.lines.size() < 5 || fnAdd(d.lines[4], d.rounds.size())) && (d.lines.size() < 6 || fnAdd(d.lines[5], d.rounds.size())) && (d.lines.size() < 7 || fnAdd(d.lines[6], d.rounds.size())) && (d.lines.size() < 8 || fnAdd(d.lines[7], d.rounds.size()))
        && (d.lines.size() < 9 || fnAdd(d.lines[8], d.rounds.size())) && (d.lines.size() < 10 || fnAdd(d.lines[9], d.rounds.size())) && (d.lines.size() < 11 || fnAdd(d.lines[10], d.rounds.size())) && (d.lines.size() < 12 || fnAdd(d.lines[11], d.rounds.size()))
        && d.rounds[0].at is int && d.first == d.rounds[0].at && d.last == d.rounds[d.rounds.size() - 1].at && d.first <= d.last && d.until > d.last;
    }
    function fnOk(id) { return fnCheck(id, request.resource.data, resource == null ? {} : resource.data); }
    // (the version is checked by nextVersion; a field's size() also refuses a number in place of text)
    function fnCheck(id, d, was) {
      return id.matches('[a-z0-9][a-z0-9-]{0,47}')
        && d.keys().hasOnly(['v', 'status', 'name', 'date', 'start', 'st', 'loc', 'guests', 'gu', 'mode', 'lines', 'rounds', 'notes', 'kc', 'kcBy', 'kcAt', 'od',
          'first', 'last', 'from', 'until', 'kq', 'was', 'chg', 'cBy', 'cAt', 'confBy', 'confAt', 'canBy', 'canAt', 'by', 'upd', 'removed'])
        && d.get('removed', false) is bool && (d.get('removed', false) == false || (d.status == 'cancelled' && d.kq == 0))
        && d.upd is int && d.status in ['draft', 'confirmed', 'cancelled']
        && d.name.size() <= 80 && (d.date.size() == 0 || d.date.size() == 10)
        && d.start is int && d.guests is int && d.guests >= 0 && d.guests <= 2000 && d.get('gu', false) is bool && d.get('st', false) is bool && d.get('od', '').size() <= 10
        && d.mode in ['all', 'stag']
        && d.loc.size() <= 60 && d.notes.size() <= 1000 && d.kc.size() <= 2000
        // the kitchen comment's author is whoever changed it, never someone else's name
        && (d.kc == was.get('kc', '') || d.kcBy == d.get('by', ''))
        && d.chg is list && d.chg.size() <= 8 && d.was is map
        && d.until is int && d.kq is int
        && d.lines is list && d.lines.size() <= 12 && d.rounds is list && d.rounds.size() <= 8
        && (d.status != 'confirmed' || fnConfirmed(d));
    }
    match /kitchens/KITCHEN_PIN/functions/{id} {
      allow read: if functionRead();
      // the head chef's Google account may also copy one as it is (move to a new kitchen PIN)
      allow create: if resource == null && (request.resource.data.v == 1 || isAdmin()) && fnBy() && fnOk(id);
      allow update: if resource != null && nextVersion()
        && ((fnStatusChange(id, resource.data, request.resource.data) && fnStatusBy() && fnStatusAudit(id, resource.data, request.resource.data)) || (fnBy() && fnOk(id)));
      allow delete: if false;
      match /hist/{v} {
        allow read: if isAdmin() || (sessOk(reader()) && (chefId(reader()) || reader() in cfg().get('fnIds', [])));
        allow create: if (fnBy() || (fnStatusBy() && fnStatusHistory(id, v))) && request.resource.data.keys().hasOnly(['was', 'at', 'by', 'what']) && request.resource.data.was is map && request.resource.data.at is int
          && request.resource.data.get('what', '') is string && request.resource.data.get('what', '').size() <= 300
          && (isAdmin() || getAfter(/databases/$(database)/documents/kitchens/KITCHEN_PIN/functions/$(id)).data.v == int(v) + 1);
        allow update, delete: if false;
      }
    }
    // The booking contact for a function, under the same id: name, phone and email. Only the function pages read it,
    // one at a time by its id; it is never listed (except by the head chef's Google account, for the backup and a PIN move),
    // and the kitchen's copy never holds it. Since 22 Oct 2026 (review S9) only a function manager reads it: the Google
    // account, or a phone whose PIN session is for someone ticked for Functions (fnIds).
    match /kitchens/KITCHEN_PIN/fncontact/{id} {
      allow get: if isAdmin() || (sessOk(reader()) && reader() in cfg().get('fnIds', []));
      allow list: if isAdmin();
      allow create, update: if fnBy() && request.resource.data.keys().hasOnly(['cname', 'phone', 'email', 'by', 'upd'])
        && request.resource.data.get('cname', '') is string && request.resource.data.get('cname', '').size() <= 80
        && request.resource.data.get('phone', '') is string && request.resource.data.get('phone', '').size() <= 30
        && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 120
        && request.resource.data.upd is int;
      allow delete: if false;
    }
    // Functions: a round ticked as sent in the kitchen (22 Oct 2026). One record per round, fnsent/<function id>_<round time>.
    // Anyone signed in with their own PIN ticks a round, as themselves. Taking a tick back (a mis-tap) is for the person who
    // ticked it within 2 minutes, a sous chef or the head chef, like a prep line. A tick is never deleted.
    function sentOk(sid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['fid', 'at', 'day', 'sent', 'sentAt', 'sentBy', 'by'])
        && d.fid is string && d.fid.size() > 0 && d.fid.size() <= 64 && d.at is int && sid == d.fid + '_' + string(d.at)
        && d.day is string && d.day.size() == 10 && d.sent is bool && d.sentAt is int && d.sentBy is string;
    }
    match /kitchens/KITCHEN_PIN/fnsent/{sid} {
      allow read: if functionRead();
      allow create: if (writer() || fnBy()) && sentOk(sid) && request.resource.data.sent == true && request.resource.data.sentBy == request.resource.data.get('by', '');
      allow update: if (writer() || fnBy()) && sentOk(sid) && (
        (request.resource.data.sent == true && resource.data.sent == false && request.resource.data.sentBy == request.resource.data.get('by', ''))
        || (request.resource.data.sent == false && resource.data.sent == true && request.resource.data.sentBy == resource.data.sentBy
          && (lead() || (resource.data.sentBy == request.resource.data.get('by', '') && request.time.toMillis() - resource.data.sentAt < 120000))));
      allow delete: if false;
    }
    // Who has seen a shift ping: one small record per person, ping and day, written when they tap Got it.
    // The record id is the day, an underscore and the writer's id. Records are never changed or deleted.
    match /kitchens/KITCHEN_PIN/notes/{id}/seen/{sid} {
      allow read: if kitchenRead();
      allow create: if (isAdmin() || staff()) && request.resource.data.day is string && request.resource.data.day.size() == 10
        && request.resource.data.at is number
        && sid == request.resource.data.day + '_' + request.resource.data.by;
      allow update, delete: if false;
    }
    // Kitchen mail: a person writes to the head chef from their name chip (#/mail). Only the head chef reads it (and the
    // sous chefs, while switched on: sousMail below).
    // "from" is the sender, kept from the first save ("by" changes when the head chef ticks one on a phone where a person
    // is signed in). The head chef ticks it done, marks it seen and may change how soon it matters. Never deleted.
    function mailOk() {
      return request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600
        && request.resource.data.cat in ['equipment', 'stock', 'safety', 'recipe', 'roster', 'idea', 'other']
        && request.resource.data.pri in ['today', 'week', 'any']
        && request.resource.data.seen is bool && request.resource.data.done is bool;
    }
    // Sous chefs may read and tick off kitchen mail while the head chef has it switched on (config/main sousMail, off
    // until then; only the head chef's Google account writes it, 23 Oct 2026). Read: this phone's PIN session is a sous
    // chef's. Write: the writer is a sous chef with a session on this phone.
    function sousMail() { return cfg().get('sousMail', false) == true; }
    function sousMailRead() { return sousMail() && sessOk(reader()) && reader() in cfg().get('sousIds', []); }
    function sousMailBy() { return sousMail() && staff() && sousBy(); }
    match /kitchens/KITCHEN_PIN/mail/{id} {
      allow read: if isAdmin() || sousMailRead();
      // The head chef may also create one when moving everything to a new kitchen PIN (an exact copy of the old record).
      allow create: if isAdmin() || (staff() && mailOk()
        && request.resource.data.from == request.resource.data.by
        && request.resource.data.at is number
        && request.resource.data.done == false && request.resource.data.seen == false
        && request.resource.data.keys().hasOnly(['from', 'by', 'cat', 'pri', 'text', 'at', 'done', 'seen']));
      allow update: if isAdmin() && mailOk()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pri', 'seen', 'seenAt', 'done', 'doneAt', 'by'])
        // a sous chef ticks it done or changes how soon it matters; seen stays for the head chef
        || sousMailBy() && mailOk()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pri', 'done', 'doneAt', 'by']);
      allow delete: if false;
    }
    // What happened to a mail (seen, done), under the same id, so the sender's phone can show it without reading the
    // message. It is read one record at a time by its id, never listed, and holds nothing else.
    match /kitchens/KITCHEN_PIN/mailstat/{id} {
      allow get: if kitchenRead();
      allow list: if isAdmin();
      allow create: if isAdmin() || (staff()
        && request.resource.data.seen == false && request.resource.data.done == false
        && request.resource.data.keys().hasOnly(['by', 'seen', 'done'])
        && getAfter(/databases/$(database)/documents/kitchens/KITCHEN_PIN/mail/$(id)).data.from == request.resource.data.by);
      allow update: if isAdmin() && request.resource.data.seen is bool && request.resource.data.done is bool
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'done', 'by'])
        || sousMailBy() && request.resource.data.done is bool
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'by']);
      allow delete: if false;
    }
    // The chef to-do list (#/todo, 23 Oct 2026): shared by the head chef and the sous chefs, never read by staff. Read by
    // the head chef's Google account or a phone whose PIN session is a chef's (sousIds or headId); written the same way.
    // st is open, done or gone (removed, kept so Undo works); the page reads only st == 'open', and done with doneAt in
    // the last 30 days. from (who wrote it) and at never change; a tick names the chef who ticked (doneBy == by).
    // Nothing is deleted. The head chef's Google account may also copy one as it is (the move to a new kitchen PIN).
    function chefId(id) { return id is string && id != '' && (id in cfg().get('sousIds', []) || id == cfg().get('headId', '')); }
    function todoBy() { return isAdmin() || (staff() && chefId(request.resource.data.by)); }
    function todoStr(k, n) { return request.resource.data.get(k, '') is string && request.resource.data.get(k, '').size() <= n; }
    function todoOk() {
      return request.resource.data.keys().hasOnly(['text', 'st', 'due', 'for', 'from', 'at', 'doneAt', 'doneBy', 'upd', 'by'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.st in ['open', 'done', 'gone']
        && todoStr('due', 10) && (request.resource.data.get('due', '') == '' || request.resource.data.get('due', '').matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && todoStr('for', 80) && todoStr('from', 80) && todoStr('doneBy', 80)
        && request.resource.data.get('at', 0) is number && request.resource.data.get('doneAt', 0) is number && request.resource.data.get('upd', 0) is number;
    }
    // Who ticked a job is only ever the writer, or left as it was (review, 23 Oct 2026). A tick names the writer. An open
    // job names no one (an untick clears it). Removed, or done and changed, a job keeps who ticked it and when, so Undo
    // puts it back exactly as it was. The head chef's Google account (no PIN session) may name the head chef.
    function todoTickOk() {
      let st = request.resource.data.st;
      let nb = request.resource.data.get('doneBy', '');
      let ob = resource == null ? '' : resource.data.get('doneBy', '');
      return isAdmin()
        || (st == 'done' && nb == request.resource.data.by)
        || (st != 'done' && nb == '')
        || (st != 'open' && resource != null && nb != '' && nb == ob
          && request.resource.data.get('doneAt', 0) == resource.data.get('doneAt', 0));
    }
    match /kitchens/KITCHEN_PIN/todos/{id} {
      allow read: if isAdmin() || (sessOk(reader()) && !functionOnly(reader()) && chefId(reader()));
      allow create: if todoBy() && todoOk() && todoTickOk() && (isAdmin() || request.resource.data.get('from', '') == request.resource.data.by);
      allow update: if todoBy() && todoOk() && todoTickOk()
        && request.resource.data.get('from', '') == resource.data.get('from', '') && request.resource.data.get('at', 0) == resource.data.get('at', 0);
      allow delete: if false;
    }
    // Phone pushes for order cut-offs (24 Oct 2026): a chef's phone keeps its push address in push/<hash of it>
    // { tok, at, ua, by }. Only the server reads them (scripts/cutoff-push.mjs, with the service account, which these
    // rules do not cover), so no phone can read anyone's address. A chef writes their own phone's, and removes only one
    // of their own (or one already gone: the server removes an address Firebase says is dead, and Turn pushes off still
    // has to work); the head chef's Google account writes as 'owner' and removes any.
    function pushOk() {
      return request.resource.data.keys().hasOnly(['tok', 'at', 'ua', 'by'])
        && request.resource.data.tok is string && request.resource.data.tok.size() > 0 && request.resource.data.tok.size() <= 500
        && request.resource.data.at is number && request.resource.data.get('ua', '') is string && request.resource.data.get('ua', '').size() <= 20;
    }
    match /kitchens/KITCHEN_PIN/push/{id} {
      allow read: if false;
      allow create, update: if pushOk() && ((isAdmin() && request.resource.data.by == 'owner') || (staff() && chefId(request.resource.data.by)));
      allow delete: if isAdmin() || (sessOk(reader()) && !functionOnly(reader()) && chefId(reader()) && (resource == null || resource.data.by == reader()));
    }
    // Supplier orders (24 Oct 2026): the chefs' shared tick list of supplier orders placed, one record per supplier and
    // cut-off day: cutdone/<day>_<supplier id> { day, sid, on, at, by }. The server sends no more pushes for one that is on.
    // Read by a chef (own PIN session) or the Google account; staff never see it. A chef's tick names that chef (their
    // PIN session); the Google account writes as 'owner', or copies ticks as they are (the move to a new kitchen PIN).
    function cutDoneOk(id) {
      return request.resource.data.keys().hasOnly(['day', 'sid', 'on', 'at', 'by'])
        && request.resource.data.day is string && request.resource.data.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.sid is string && request.resource.data.sid.matches('[a-z0-9-]{1,40}')
        && id == request.resource.data.day + '_' + request.resource.data.sid
        && request.resource.data.on is bool && request.resource.data.at is number;
    }
    match /kitchens/KITCHEN_PIN/cutdone/{id} {
      allow read: if isAdmin() || (sessOk(reader()) && !functionOnly(reader()) && chefId(reader()));
      allow create, update: if cutDoneOk(id) && (isAdmin() || (staff() && chefId(request.resource.data.by)));
      allow delete: if false;
    }
    // Supplier catalogue and order history (24 Oct 2026). Goods and pars never live in the public shell or config/main.
    // A chef's current PIN session may read; only the head chef or the verified owner changes the catalogue. The page
    // validates each item and snapshot line, while these rules bound the arrays and enforce roles, revisions and the
    // writes that must be together. The owner may copy valid records unchanged when moving the kitchen PIN.
    function supRead() { return isAdmin() || (sessOk(reader()) && !functionOnly(reader()) && chefId(reader())); }
    function supEdit() { return isAdmin() || headWrite(); }
    function supChef() { return isAdmin() || (staff() && chefId(request.resource.data.by)); }
    function supId(id) { return id is string && id.matches('[a-zA-Z0-9_-]{1,80}'); }
    function supString(d, k, n) { return d.get(k, '') is string && d.get(k, '').size() <= n; }
    function supDay(day) { return day is string && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'); }
    function supDoc(sid) { return /databases/$(database)/documents/kitchens/KITCHEN_PIN/suppliers/$(sid); }
    function supAuditDoc(sid, v) { return /databases/$(database)/documents/kitchens/KITCHEN_PIN/suppliers/$(sid)/audit/$(string(v)); }
    function supOrderDoc(sid, id) { return /databases/$(database)/documents/kitchens/KITCHEN_PIN/suppliers/$(sid)/orders/$(id); }
    function supLinkDoc(day, cid) { return /databases/$(database)/documents/kitchens/KITCHEN_PIN/supplierlinks/$(day + '_' + cid); }
    function supCutDoc(day, cid) { return /databases/$(database)/documents/kitchens/KITCHEN_PIN/cutdone/$(day + '_' + cid); }
    function supCatalogueOk(sid) {
      let d = request.resource.data;
      return supId(sid) && d.keys().hasOnly(['name', 'cutoffId', 'v', 'items', 'at', 'by'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && supString(d, 'cutoffId', 40) && (d.cutoffId == '' || d.cutoffId.matches('[a-z0-9-]{1,40}'))
        && d.v is int && d.v > 0 && d.items is list && d.items.size() <= 600
        && d.at is number && d.at >= 0 && d.by is string && d.by.size() > 0 && d.by.size() <= 80;
    }
    function supCatalogueAudit(sid) {
      let d = request.resource.data;
      let a = getAfter(supAuditDoc(sid, d.v)).data;
      return !exists(supAuditDoc(sid, d.v)) && a.v == d.v && a.by == d.by && a.at == d.at;
    }
    function supAuditOk(revision) {
      let d = request.resource.data;
      return d.keys().hasOnly(['v', 'itemId', 'action', 'before', 'after', 'at', 'by'])
        && d.v is int && d.v > 0 && revision == string(d.v)
        && supString(d, 'itemId', 80) && d.action is string && d.action.size() > 0 && d.action.size() <= 80
        && (d.before == null || d.before is map) && (d.after == null || d.after is map)
        && d.at is number && d.at >= 0 && d.by is string && d.by.size() > 0 && d.by.size() <= 80;
    }
    function supAuditPair(sid) {
      let d = request.resource.data;
      let c = getAfter(supDoc(sid)).data;
      return (!exists(supDoc(sid)) || get(supDoc(sid)).data.v < d.v)
        && c.v == d.v && c.by == d.by && c.at == d.at;
    }
    function supOrderOk(sid, id) {
      let d = request.resource.data;
      return supId(sid) && id is string && id.matches('[a-zA-Z0-9_-]{1,100}')
        && d.keys().hasOnly(['sid', 'supplierName', 'v', 'at', 'day', 'deliveryDay', 'cutoffDay', 'cutoffId', 'by', 'lines'])
        && d.sid == sid && d.supplierName is string && d.supplierName.size() > 0 && d.supplierName.size() <= 80
        && d.v is int && d.v > 0 && d.at is number && d.at >= 0 && supDay(d.day)
        && d.deliveryDay is string && (d.deliveryDay == '' || supDay(d.deliveryDay))
        && d.cutoffDay is string && (d.cutoffDay == '' || supDay(d.cutoffDay))
        && d.cutoffId is string && (d.cutoffId == '' || d.cutoffId.matches('[a-z0-9-]{1,40}'))
        && ((d.cutoffId == '' && d.cutoffDay == '') || (d.cutoffId != '' && d.cutoffDay != ''))
        && d.by is string && d.by.size() > 0 && d.by.size() <= 80
        && d.lines is list && d.lines.size() > 0 && d.lines.size() <= 300;
    }
    function supOrderCurrent(sid) {
      let d = request.resource.data;
      let c = get(supDoc(sid)).data;
      return d.v == c.v && d.supplierName == c.name && (d.cutoffId == '' || d.cutoffId == c.cutoffId);
    }
    function supOrderPair(sid, id) {
      let d = request.resource.data;
      let l = getAfter(supLinkDoc(d.cutoffDay, d.cutoffId)).data;
      let c = getAfter(supCutDoc(d.cutoffDay, d.cutoffId)).data;
      return d.cutoffId == '' || (l.sid == sid && l.orderId == id && l.cutoffId == d.cutoffId
        && l.day == d.cutoffDay && l.by == d.by && l.at == d.at
        && c.sid == d.cutoffId && c.day == d.cutoffDay && c.on == true && c.by == d.by && c.at == d.at);
    }
    function supLinkOk(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['sid', 'cutoffId', 'day', 'v', 'orderId', 'at', 'by'])
        && supId(d.sid) && d.cutoffId is string && d.cutoffId.matches('[a-z0-9-]{1,40}')
        && supDay(d.day) && id == d.day + '_' + d.cutoffId
        && d.v is int && d.v > 0 && d.orderId is string && d.orderId.matches('[a-zA-Z0-9_-]{1,100}')
        && d.at is number && d.at >= 0 && d.by is string && d.by.size() > 0 && d.by.size() <= 80;
    }
    function supLinkPair() {
      let d = request.resource.data;
      let p = supOrderDoc(d.sid, d.orderId);
      let o = getAfter(p).data;
      let c = getAfter(supCutDoc(d.day, d.cutoffId)).data;
      return !exists(p) && o.sid == d.sid && o.cutoffId == d.cutoffId && o.cutoffDay == d.day
        && o.by == d.by && o.at == d.at
        && c.sid == d.cutoffId && c.day == d.day && c.on == true && c.by == d.by && c.at == d.at;
    }
    match /kitchens/KITCHEN_PIN/suppliers/{sid} {
      allow read: if supRead();
      allow create: if supEdit() && supCatalogueOk(sid) && (isAdmin() || (request.resource.data.v == 1 && supCatalogueAudit(sid)));
      allow update: if supEdit() && supCatalogueOk(sid) && ((isAdmin() && request.resource.data == resource.data)
        || (request.resource.data.v == resource.data.v + 1 && supCatalogueAudit(sid)));
      allow delete: if false;
      match /audit/{revision} {
        allow read: if supRead();
        allow create: if supEdit() && supAuditOk(revision) && (isAdmin() || supAuditPair(sid));
        allow update: if isAdmin() && request.resource.data == resource.data;
        allow delete: if false;
      }
      match /orders/{orderId} {
        allow read: if supRead();
        allow create: if supChef() && supOrderOk(sid, orderId) && (isAdmin() || (supOrderCurrent(sid) && supOrderPair(sid, orderId)));
        allow update: if isAdmin() && request.resource.data == resource.data;
        allow delete: if false;
      }
    }
    match /kitchens/KITCHEN_PIN/supplierlinks/{id} {
      allow read: if supRead();
      allow create: if supChef() && supLinkOk(id) && (isAdmin() || (request.resource.data.v == 1 && supLinkPair()));
      allow update: if supChef() && supLinkOk(id) && ((isAdmin() && request.resource.data == resource.data)
        || (request.resource.data.v == resource.data.v + 1 && request.resource.data.sid == resource.data.sid
          && request.resource.data.day == resource.data.day && request.resource.data.cutoffId == resource.data.cutoffId && supLinkPair()));
      allow delete: if false;
    }
    // pushsent (what the server has sent) has no rule: only the server reads and writes it.
    // The drinks run: each person's usual coffee or drink, one record per person (the record id is their id).
    // Everyone with the kitchen PIN reads them; only that person writes their own (own PIN session).
    // The head chef may also create one when moving everything to a new kitchen PIN (an exact copy of the old record).
    function dkStr(k, n) { return request.resource.data.get(k, '') is string && request.resource.data.get(k, '').size() <= n; }
    match /kitchens/KITCHEN_PIN/drinks/{id} {
      allow read: if kitchenRead();
      allow create, update: if isAdmin() || (staff() && id == request.resource.data.by
        && request.resource.data.keys().hasOnly(['by', 'kind', 'size', 'milk', 'shot', 'sugar', 'note', 'cold', 'other', 'at'])
        && dkStr('kind', 12) && dkStr('cold', 12) && dkStr('size', 12) && dkStr('milk', 12) && dkStr('shot', 12) && dkStr('sugar', 12)
        && dkStr('note', 40) && dkStr('other', 60) && request.resource.data.at is number);
      allow delete: if isAdmin();
    }
    // Kitchen sections: the section a person works on for the day (picked after their PIN; the head chef and sous chefs
    // get their role). One record per person and day, shifts/<day>_<id>, written only by that person (own PIN session).
    // The head chef may also create one when moving everything to a new kitchen PIN (an exact copy of the old record).
    match /kitchens/KITCHEN_PIN/shifts/{sid} {
      allow read: if kitchenRead();
      allow create, update: if isAdmin() || (staff()
        && sid == request.resource.data.day + '_' + request.resource.data.by
        && request.resource.data.keys().hasOnly(['by', 'day', 'sec', 'name', 'auto', 'at'])
        && request.resource.data.day is string && request.resource.data.day.size() == 10
        && request.resource.data.sec is string && request.resource.data.sec.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.get('auto', false) is bool
        && request.resource.data.at is number);
      allow delete: if isAdmin();
    }
    // Only a person on the list (config/main.staffIds, kept in step by the admin panel and a sous chef's staff page)
    // may set a PIN, once. So nobody with just the kitchen PIN can make up a new writer.
    // The head chef may also create one: the move to a new kitchen PIN copies every stored PIN as it is.
    match /kitchens/KITCHEN_PIN/staffpins/{id} {
      allow read: if isAdmin();
      // a first PIN only while that person's set-up window is open (config/main pinOpen, 22 Oct 2026): opened when they
      // are added (7 days) or by Reset PIN (30 minutes), so nobody holding the kitchen PIN can take a name by setting it first
      allow create: if isAdmin() || (request.auth != null && request.resource.data.keys().hasOnly(['hash', 'setAt', 'name'])
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 40 && request.resource.data.get('setAt', 0) is number && request.resource.data.hash is string && request.resource.data.hash.size() == 64
        && id in cfg().get('staffIds', [])
        && request.time.toMillis() < cfg().get('pinOpen', {}).get(id, 0)
        && getAfter(setDoc(id)).data.at is number);
      allow update, delete: if isAdmin();
    }
    match /kitchens/KITCHEN_PIN/pinset/{id} {
      allow get: if isAdmin() || (request.auth != null && onList(id));
      allow list: if isAdmin();
      allow create: if isAdmin() || (request.auth != null && onList(id)
        && request.time.toMillis() < cfg().get('pinOpen', {}).get(id, 0)
        && request.resource.data.keys().hasOnly(['at', 'name']) && request.resource.data.at is number
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 40
        && !exists(pinDoc(id)) && getAfter(pinDoc(id)).data.hash is string);
      allow update, delete: if isAdmin();
    }
    // A PIN try (22 Oct 2026): the phone writes the try first, on its own, so a wrong one still counts. One try per person
    // every 20 seconds. Nobody reads it: only the session rule below compares it with the stored hash.
    match /kitchens/KITCHEN_PIN/tries/{id} {
      allow read: if false;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['tok', 'at', 'uid'])
        && request.resource.data.tok is string && request.resource.data.tok.size() == 64
        && request.resource.data.at == request.time && request.resource.data.uid == request.auth.uid
        && (resource == null || request.time > resource.data.at + duration.value(20, 's'));
      allow delete: if isAdmin();
    }
    // A session: this phone (the anonymous or Google sign-in's uid) writes as this person. Opened only right after a
    // right PIN try from this phone (within 2 minutes), for at most 31 days; a session still running may move its end
    // forward; the phone deletes it on Sign out.
    match /kitchens/KITCHEN_PIN/sessions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['by', 'pinAt', 'exp', 'at'])
        && request.resource.data.by is string && onList(request.resource.data.by)
        && request.resource.data.exp is number && request.resource.data.exp <= request.time.toMillis() + 31 * 86400000
        && request.resource.data.at == request.time
        && exists(setDoc(request.resource.data.by)) && request.resource.data.pinAt == get(setDoc(request.resource.data.by)).data.at
        && (
          // a new session: the last try for this person was from this phone, in the last 2 minutes, and right
          (exists(triesDoc(request.resource.data.by))
            && get(triesDoc(request.resource.data.by)).data.uid == uid
            && request.time < get(triesDoc(request.resource.data.by)).data.at + duration.value(2, 'm')
            && exists(pinDoc(request.resource.data.by))
            && get(triesDoc(request.resource.data.by)).data.tok == get(pinDoc(request.resource.data.by)).data.hash)
          // or the same session moved forward while it is still running
          || (resource != null && resource.data.by == request.resource.data.by && resource.data.pinAt == request.resource.data.pinAt
            && resource.data.exp > request.time.toMillis())
        );
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }
    // The older PIN proof, switched off in phase 2 (22 Oct 2026): nothing writes it any more, and the head chef's Google
    // account may clear the old records.
    match /kitchens/KITCHEN_PIN/proofs/{id} {
      allow read, create, update: if false;
      allow delete: if isAdmin();
    }
    // A person's tally (visits, lines added, ticks): their own, or anyone's for the head chef and sous chefs (an untick).
    match /kitchens/KITCHEN_PIN/activity/{id} {
      allow read: if kitchenRead();
      allow create, update: if isAdmin() || (staff() && (sousBy() || id == request.resource.data.by)
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && onlyKeys(['name', 'visits', 'lastSeen', 'added', 'lastAdded', 'ticked', 'by']));
      allow delete: if isAdmin();
    }
    // Sections and what the prep list learned: anyone with a PIN counts a use; hiding one is for the head chef or a sous chef.
    function hideOk() { return sousBy() || request.resource.data.get('hidden', false) == resource.data.get('hidden', false); }
    match /kitchens/KITCHEN_PIN/sections/{id} {
      allow read: if kitchenRead();
      allow create: if isAdmin() || (staff() && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && onlyKeys(['name', 'uses', 'lastUsed', 'lastBy', 'hidden', 'by']) && (sousBy() || request.resource.data.get('hidden', false) == false));
      allow update: if isAdmin() || (staff() && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && onlyKeys(['name', 'uses', 'lastUsed', 'lastBy', 'hidden', 'by']) && hideOk());
      allow delete: if isAdmin();
    }
    match /kitchens/KITCHEN_PIN/learned/{id} {
      allow read: if kitchenRead();
      // the counts come only from the nightly job (service account); a sous chef hides or shows an item (22 Oct 2026)
      allow create: if isAdmin();
      allow update: if isAdmin() || (staff() && sousBy() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'by']) && request.resource.data.get('hidden', false) is bool);
      allow delete: if isAdmin();
    }
    // What the order list has learned: one record per item ordered (text, uses, weekdays, usual amounts). Written by the
    // nightly job only (service account); the phones read it (22 Oct 2026).
    match /kitchens/KITCHEN_PIN/ordlearned/{id} {
      allow read: if kitchenRead();
      allow create: if isAdmin();
      allow update: if isAdmin() || (staff() && sousBy() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'by']) && request.resource.data.get('hidden', false) is bool);
      allow delete: if isAdmin();
    }
    match /kitchens/KITCHEN_PIN/learnlog/{id} {
      allow read: if kitchenRead();
      allow create: if isAdmin();   // the nightly job's claim that a day was counted (service account), never a phone
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
