// Firestore security rules for the prep book. The live copy is edited in the Firebase console
// (Firestore Database > Rules). Keep this file in step with it after every change.
// Replace KITCHEN_PIN with the kitchen PIN and OWNER_EMAIL with the head chef's Google account.
// Never commit the real values: this repository is public.
//
// Reading needs only the kitchen PIN (it is the path). Writing needs a person's own PIN:
// every write carries the writer's id (by) and, in the same batch, a write-only proof (proofs/<id>.tok).
// The rules compare the proof with the stored PIN hash (staffpins/<id>.hash), which nobody can read.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'OWNER_EMAIL' && request.auth.token.email_verified == true;
    }
    function pinDoc(id) { return /databases/$(database)/documents/kitchens/KITCHEN_PIN/staffpins/$(id); }
    function proofDoc(id) { return /databases/$(database)/documents/kitchens/KITCHEN_PIN/proofs/$(id); }
    function setDoc(id) { return /databases/$(database)/documents/kitchens/KITCHEN_PIN/pinset/$(id); }
    function staff() {
      return request.resource.data.by is string
        && exists(pinDoc(request.resource.data.by))
        && getAfter(proofDoc(request.resource.data.by)).data.tok == get(pinDoc(request.resource.data.by)).data.hash;
    }
    function writer() { return isAdmin() || staff(); }

    match /kitchens/KITCHEN_PIN/config/main {
      allow read: if true;
      allow create: if isAdmin();
      // A sous chef (own PIN, no Google sign-in) may only change the people list, and only if listed in sousIds.
      allow update: if isAdmin() || (staff()
        && request.resource.data.by in resource.data.get('sousIds', [])
        && request.resource.data.people is list && request.resource.data.people.size() <= 80
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['people', 'updated', 'updatedBy', 'by']));
      allow delete: if isAdmin();
    }
    match /kitchens/KITCHEN_PIN/config/admins { allow read, write: if isAdmin(); }
    match /kitchens/KITCHEN_PIN/days/{day}/items/{item} {
      allow read: if true;
      allow create, update: if writer() && request.resource.data.text is string && request.resource.data.text.size() <= 160;
      allow delete: if false;
    }
    match /kitchens/KITCHEN_PIN/staffpins/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.hash is string && request.resource.data.hash.size() == 64
        && getAfter(setDoc(id)).data.at is number;
      allow update, delete: if isAdmin();
    }
    match /kitchens/KITCHEN_PIN/pinset/{id} {
      allow read: if true;
      allow create: if request.resource.data.at is number;
      allow update, delete: if isAdmin();
    }
    match /kitchens/KITCHEN_PIN/proofs/{id} {
      allow read: if false;
      allow create, update: if request.resource.data.tok is string && request.resource.data.tok.size() == 64;
      allow delete: if isAdmin();
    }
    match /kitchens/KITCHEN_PIN/activity/{id} {
      allow read: if true;
      allow create, update: if writer() && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow delete: if isAdmin();
    }
    match /kitchens/KITCHEN_PIN/sections/{id} {
      allow read: if true;
      allow create, update: if writer() && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow delete: if isAdmin();
    }
    match /kitchens/KITCHEN_PIN/learned/{id} {
      allow read: if true;
      allow create, update: if writer() && request.resource.data.text is string && request.resource.data.text.size() <= 160;
      allow delete: if isAdmin();
    }
    match /kitchens/KITCHEN_PIN/learnlog/{id} {
      allow read: if true;
      allow create: if writer() && request.resource.data.at is number;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
